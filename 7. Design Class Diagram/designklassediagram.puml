@startuml
' Designklassediagram (DCD) – Vekto, UC1–UC4
' Stil som undervisningens lagdelte DCD'er (Pr19 Disaheim og Pr20 BookMeeting):
' UI Layer -> Application Layer (use case controllers + repositories) -> Domain Layer.
' Hver besked i sekvensdiagrammerne ("6. Sekvens Diagrammer") er en operation i modtagerens klasse.

left to right direction
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 70
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam package {
  BorderStyle dashed
  BorderColor black
  BackgroundColor white
  FontStyle plain
  FontSize 14
}
skinparam class {
  BackgroundColor white
  BorderColor black
  ArrowColor black
  FontStyle plain
  StereotypeFontSize 11
}
hide circle
hide <<enumeration>> methods

title DCD

' =====================================================================
package "UI Layer" {

  class EmployeeView {
    - controller : CreateEmployeeController
  }

  class CustomerView {
    - controller : CreateCustomerController
  }

  class ServiceView {
    - controller : CreateServiceController
  }

  class ServiceReceiptView {
    - controller : ServiceReceiptController
  }
}

' =====================================================================
package "Application Layer" {

  class CreateEmployeeController {
    - employeeRepo : EmployeeRepo
    --
    + CreateEmployee(name : string, initials : string) : Employee
    + GetAllEmployees() : Employee[0..*]
  }

  class CreateCustomerController {
    - customerRepo : CustomerRepo
    --
    + CreateCustomer(name : string, phoneNumber : string) : Customer
    + GetAllCustomers() : Customer[0..*]
  }

  class CreateServiceController {
    - customerRepo : CustomerRepo
    - serviceRepo : ServiceRepo
    --
    + SearchCustomer(phoneNumber : string) : Customer
    + CreateService(phoneNumber : string,
    <U+2003><U+2003>brand : string, model : string,
    <U+2003><U+2003>errorType : string, description : string) : Service
  }

  class ServiceReceiptController {
    - serviceRepo : ServiceRepo
    --
    + SearchServices(searchText : string,
    <U+2003><U+2003>status : ServiceStatus) : Service[0..*]
    + GetService(serviceId : int) : Service
  }

  class EmployeeRepo {
    - employees : Employee[0..*]
    --
    + GetById(initials : string) : Employee
    + GetAll() : Employee[0..*]
    + Add(employee : Employee)
  }

  class CustomerRepo {
    - customers : Customer[0..*]
    --
    + GetById(phoneNumber : string) : Customer
    + GetAll() : Customer[0..*]
    + Add(customer : Customer)
  }

  class ServiceRepo {
    - services : Service[0..*]
    --
    + GetById(serviceId : int) : Service
    + GetNextId() : int
    + Search(searchText : string,
    <U+2003><U+2003>status : ServiceStatus) : Service[0..*]
    + Add(service : Service)
  }
}

' =====================================================================
package "Domain Layer" {

  class Employee {
    + Name : string
    + «get» Initials : string
    --
    + Employee(name : string, initials : string)
  }

  class Customer {
    + Name : string
    + «get» PhoneNumber : string
    --
    + Customer(name : string, phoneNumber : string)
  }

  class Service {
    + «get» ServiceId : int
    + DropOffDate : DateTime
    + Brand : string
    + Model : string
    + ErrorType : string
    + Description : string
    + Status : ServiceStatus
    + Customer : Customer
    --
    + Service(serviceId : int, customer : Customer,
    <U+2003><U+2003>brand : string, model : string,
    <U+2003><U+2003>errorType : string, description : string)
  }

  enum ServiceStatus <<enumeration>> {
    Open
    Closed
  }
}

' ---------- UI Layer -> controller ----------
EmployeeView       -- CreateEmployeeController
CustomerView       -- CreateCustomerController
ServiceView        -- CreateServiceController
ServiceReceiptView -- ServiceReceiptController

' ---------- Controller -> repository ----------
CreateEmployeeController -- EmployeeRepo
CreateCustomerController -- CustomerRepo
CreateServiceController  -- CustomerRepo
CreateServiceController  -- ServiceRepo
ServiceReceiptController -- ServiceRepo

' ---------- Repository -> domæneklasse ----------
EmployeeRepo -- "0..*" Employee
CustomerRepo -- "0..*" Customer
ServiceRepo  -- "0..*" Service

' ---------- Domænerelationer ----------
Customer "1" -[norank]- "*" Service
Service .. ServiceStatus
@enduml
