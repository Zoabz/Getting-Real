@startuml
sprite $ul <svg viewBox="0 0 287 1"><rect width="287" height="1" fill="#000000"/></svg>
title
<b>UC5 - Service oversigt over reparationer</b>
<$ul>
end title
hide footbox
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam actor {
  BackgroundColor white
}
skinparam participant {
  BackgroundColor white
}

actor ":Mekaniker"
participant ":System" as System

":Mekaniker" -> System : vaelgService(serviceId)

System --> ":Mekaniker" : kundenavn, kundeTlf, mærke - model, fejltype, beskrivelse,\nregistrerede reservedele

":Mekaniker" -> System : registrerUdfoertArbejde(serviceId, medarbejder, beskrivelse)

alt service, medarbejder eller beskrivelse mangler
  System --> ":Mekaniker" : fejlbesked
else else
  System --> ":Mekaniker" : Status = "Lukket", lukketidspunkt
end

@enduml
