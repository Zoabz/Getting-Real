<Window x:Class="Vekto.EmployeeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Værkstedsstyring - Opret medarbejder" Height="550" Width="1100">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR (kopieret fra MainWindow) ================= -->
        <Grid Grid.Column="0" Background="#FFE5CCC2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo -->
            <StackPanel Grid.Row="0" Margin="15,20,15,20">
                <TextBlock Text="Værkstedsstyring" Foreground="Black" FontWeight="Bold" FontSize="16"/>
                <TextBlock Text="Service - Lager - Kunder" Foreground="Black"/>
            </StackPanel>

            <!-- Menu: her er det Opret medarbejder, der er markeret -->
            <StackPanel Grid.Row="1" Margin="10,0,10,0">
                <Label Content="Kunder og medarbejdere" Foreground="Black"/>
                <Button x:Name="btnOpretMedarbejder" Content="Opret medarbejder" Height="30" Background="#FFC4A69A" Foreground="Black" FontWeight="Bold"/>
                <Button x:Name="btnOpretKunde" Content="Opret kunde" Height="30" Background="#FFEBEBEB" Foreground="Black" Click="btnOpretKunde_Click"/>

                <Label Content="Service" Foreground="Black" Margin="0,10,0,0"/>
                <Button x:Name="btnOpretService" Content="Opret service" Height="30" Background="#FFEBEBEB" Foreground="Black" Click="btnOpretService_Click"/>
                <Button x:Name="btnReservedeleUdtag" Content="Reservedele udtag" Height="30" Background="#FFEBEBEB" Foreground="Black"/>
                <Button x:Name="btnServiceOversigt" Content="Service oversigt" Height="30" Background="#FFEBEBEB" Foreground="Black"/>

                <Label Content="Lager" Foreground="Black" Margin="0,10,0,0"/>
                <Button x:Name="btnLagerOgBestilling" Content="Lager og bestilling" Height="30" Background="#FFEBEBEB" Foreground="Black"/>
                <Button x:Name="btnOpretReservedel" Content="Opret reservedel" Height="30" Background="#FFEBEBEB" Foreground="Black"/>
                <Button x:Name="btnReservedeleModtagelse" Content="Reservedele modtagelse" Height="30" Background="#FFEBEBEB" Foreground="Black"/>
            </StackPanel>
        </Grid>

        <!-- ================= OPRET MEDARBEJDER ================= -->
        <Grid Grid.Column="1" Background="WhiteSmoke">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Overskrift -->
            <StackPanel Grid.Row="0" Margin="20,20,20,0">
                <TextBlock Text="Opret medarbejder" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Tilføj en medarbejder med fulde navn og initialer (navn kort)." Foreground="Gray"/>
            </StackPanel>

            <!-- Beskeder: fejl i rød, bekræftelse i grøn -->
            <StackPanel Grid.Row="1" Margin="20,10,20,10">
                <TextBlock x:Name="tbError" Foreground="Red"/>
                <TextBlock x:Name="tbSuccess" Foreground="Green"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="20,0,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== Ny medarbejder ===== -->
                <StackPanel Grid.Column="0" Background="White">
                    <Label Content="Ny medarbejder" FontSize="15" FontWeight="Bold" Margin="10"/>

                    <Grid Margin="10,0,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Navn"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="tbName" Height="25" Margin="0,0,0,5"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Navn kort"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="tbInitials" Height="25" Margin="0,0,0,5"/>

                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Foreground="Gray" Text="Initialerne skal være unikke"/>
                            <TextBlock Foreground="Gray" Text="og vises på kvitteringer."/>
                        </StackPanel>

                        <Button Grid.Row="3" Grid.Column="1" x:Name="btnCreate" Content="Opret"
                                Width="80" Height="30" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Background="#FFEBEBEB" Foreground="Black" Click="btnCreate_Click"/>
                    </Grid>
                </StackPanel>

                <!-- ===== Medarbejderliste ===== -->
                <StackPanel Grid.Column="2" Background="White">
                    <Label x:Name="lblEmployeeCount" Content="Medarbejdere (0)" FontSize="15" FontWeight="Bold" Margin="10"/>
                    <ListBox x:Name="lbEmployees" Height="250" Margin="10,0,10,10"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
