<Window x:Class="Vekto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Værkstedsstyring - Opret service" Height="550" Width="1100">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR (kopieres til alle vinduer) ================= -->
        <Grid Grid.Column="0" Background="#FFE5CCC2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo -->
            <StackPanel Grid.Row="0" Margin="15,20,15,20">
                <TextBlock Text="Værkstedsstyring" Foreground="Black" FontWeight="Bold" FontSize="16"/>
                <TextBlock Text="Service - Lager - Kunder" Foreground="Black"/>
            </StackPanel>

            <!-- Menu: alle knapper er ens.
                 Det vindue, man er i, har en mørkere baggrund (#FFC4A69A) og fed skrift. -->
            <StackPanel Grid.Row="1" Margin="10,0,10,0">
                <Label Content="Kunder og medarbejdere" Foreground="Black"/>
                <Button x:Name="btnOpretMedarbejder" Content="Opret medarbejder" Height="30" Background="#FFEBEBEB" Foreground="Black" Click="btnOpretMedarbejder_Click"/>
                <Button x:Name="btnOpretKunde" Content="Opret kunde" Height="30" Background="#FFEBEBEB" Foreground="Black" Click="btnOpretKunde_Click"/>

                <Label Content="Service" Foreground="Black" Margin="0,10,0,0"/>
                <Button x:Name="btnOpretService" Content="Opret service" Height="30" Background="#FFC4A69A" Foreground="Black" FontWeight="Bold"/>
                <Button x:Name="btnReservedeleUdtag" Content="Reservedele udtag" Height="30" Background="#FFEBEBEB" Foreground="Black"/>
                <Button x:Name="btnServiceOversigt" Content="Service oversigt" Height="30" Background="#FFEBEBEB" Foreground="Black"/>

                <Label Content="Lager" Foreground="Black" Margin="0,10,0,0"/>
                <Button x:Name="btnLagerOgBestilling" Content="Lager og bestilling" Height="30" Background="#FFEBEBEB" Foreground="Black"/>
                <Button x:Name="btnOpretReservedel" Content="Opret reservedel" Height="30" Background="#FFEBEBEB" Foreground="Black"/>
                <Button x:Name="btnReservedeleModtagelse" Content="Reservedele modtagelse" Height="30" Background="#FFEBEBEB" Foreground="Black"/>
            </StackPanel>
        </Grid>

        <!-- ================= OPRET SERVICE ================= -->
        <Grid Grid.Column="1" Background="WhiteSmoke">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Overskrift -->
            <StackPanel Grid.Row="0" Margin="20,20,20,0">
                <TextBlock Text="Opret service" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Find kunden på telefonnummer, udfyld produktinfo og opret servicen." Foreground="Gray"/>
            </StackPanel>

            <!-- Fejlbesked, fx "Skriv bilens mærke, fx Hyundai." -->
            <StackPanel Grid.Row="1" Margin="20,10,20,10">
                <TextBlock x:Name="tbMessage" Foreground="Red"/>
                <TextBlock x:Name="tbSuccess" Foreground="Green"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="20,0,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== 1. Vælg kunde ===== -->
                <StackPanel Grid.Column="0" Background="White">
                    <Label Content="1. Vælg kunde" FontSize="15" FontWeight="Bold" Margin="10"/>

                    <Grid Margin="10,0,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Tlf. nr."/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="tbPhone" Height="25"
                                 TextChanged="tbPhone_TextChanged"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Kunde" Margin="0,10,0,0"/>
                        <Label Grid.Row="1" Grid.Column="1" x:Name="lblCustomer" Content="Ingen kunde fundet"
                               Margin="0,10,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- ===== 2. Produkt info ===== -->
                <StackPanel Grid.Column="2" Background="White">
                    <Label Content="2. Produkt info" FontSize="15" FontWeight="Bold" Margin="10"/>

                    <Grid Margin="10,0,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Mærke"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="tbBrand" Height="25" Margin="0,0,0,5"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Model"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="tbModel" Height="25" Margin="0,0,0,5"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Fejltype"/>
                        <ListBox Grid.Row="2" Grid.Column="1" x:Name="lbErrorType" Height="70" Margin="0,0,0,5"/>

                        <Label Grid.Row="3" Grid.Column="0" Content="Fejl beskrivelse"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="tbDescription" Height="60" Margin="0,0,0,5"/>

                        <Button Grid.Row="4" Grid.Column="1" x:Name="btnCreate" Content="Opret"
                                Width="80" Height="30" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Background="#FFEBEBEB" Foreground="Black" Click="btnCreate_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
