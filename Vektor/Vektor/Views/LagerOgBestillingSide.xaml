<UserControl x:Class="Vektor.Views.LagerOgBestillingSide"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Lager og bestilling" Style="{StaticResource SideTitel}"/>

        <!-- Lageroversigt -->
        <Border Style="{StaticResource Panel}">
            <StackPanel>
                <Grid>
                    <TextBlock Text="Lageroversigt" Style="{StaticResource SektionTitel}"/>
                    <TextBlock x:Name="txtOpsummering" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,0,0"/>
                </Grid>
                <DataGrid x:Name="dgLager">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Reservedel" Binding="{Binding Navn}" Width="*"/>
                        <DataGridTextColumn Header="Leverandør" Binding="{Binding Leverandør}" Width="*"/>
                        <DataGridTextColumn Header="På lager" Binding="{Binding PåLager}" Width="100"/>
                        <DataGridTextColumn Header="Minimum" Binding="{Binding Minimum}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Skal bestilles -->
        <Border Style="{StaticResource Panel}" Margin="0,24,0,0">
            <StackPanel>
                <TextBlock Text="Skal bestilles" Style="{StaticResource SektionTitel}"/>
                <DataGrid x:Name="dgBestilling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Reservedel" Binding="{Binding Navn}" Width="*"/>
                        <DataGridTextColumn Header="Leverandør" Binding="{Binding Leverandør}" Width="*"/>
                        <DataGridTextColumn Header="På lager" Binding="{Binding PåLager}" Width="100"/>
                        <DataGridTextColumn Header="Minimum" Binding="{Binding Minimum}" Width="100"/>
                        <DataGridTextColumn Header="Mangler" Binding="{Binding Mangler}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="txtIngen" Text="Ingen reservedele skal bestilles." Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
