<UserControl x:Class="Vektor.Views.OpretServiceSide"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Vektor.Views">
    <StackPanel>
        <TextBlock Text="Opret service" Style="{StaticResource SideTitel}"/>
        <views:Besked x:Name="besked"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Vælg kunde -->
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="1. Vælg kunde" Style="{StaticResource SektionTitel}"/>

                    <TextBlock Text="Søg på tlf. nr. eller navn" Style="{StaticResource FeltTitel}"/>
                    <TextBox x:Name="txtSøg" TextChanged="Søg_TextChanged"/>

                    <TextBlock Text="Kunder" Style="{StaticResource FeltTitel}"/>
                    <ListBox x:Name="lstKunder" Height="170" SelectionChanged="Kunde_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Navn, Mode=OneWay}"/> (<Run Text="{Binding Telefonnummer, Mode=OneWay}"/>)
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Valgt kunde" Style="{StaticResource FeltTitel}"/>
                    <TextBox x:Name="txtValgtKunde" IsReadOnly="True" Text="Ingen kunde valgt" Margin="0"/>
                </StackPanel>
            </Border>

            <!-- 2. Produkt info -->
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="2. Produkt info" Style="{StaticResource SektionTitel}"/>

                    <TextBlock Text="Mærke" Style="{StaticResource FeltTitel}"/>
                    <TextBox x:Name="txtMærke"/>

                    <TextBlock Text="Model" Style="{StaticResource FeltTitel}"/>
                    <TextBox x:Name="txtModel"/>

                    <TextBlock Text="Fejltype" Style="{StaticResource FeltTitel}"/>
                    <ComboBox x:Name="cmbFejltype"/>

                    <TextBlock Text="Fejlbeskrivelse" Style="{StaticResource FeltTitel}"/>
                    <TextBox x:Name="txtBeskrivelse" Style="{StaticResource StortTekstfelt}"/>

                    <Button Content="Opret service" Click="Opret_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
