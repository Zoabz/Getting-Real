<UserControl x:Class="Vektor.Views.ReservedeleUdtagSide"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Vektor.Views">
    <StackPanel>
        <TextBlock Text="Reservedele udtag" Style="{StaticResource SideTitel}"/>
        <views:Besked x:Name="besked"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Service og medarbejder -->
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Service og medarbejder" Style="{StaticResource SektionTitel}"/>

                    <TextBlock Text="Vælg service" Style="{StaticResource FeltTitel}"/>
                    <ComboBox x:Name="cmbService" ItemTemplate="{StaticResource ServiceVisning}"
                              SelectionChanged="Service_SelectionChanged"/>

                    <TextBlock Text="Vælg medarbejder" Style="{StaticResource FeltTitel}"/>
                    <ComboBox x:Name="cmbMedarbejder" Margin="0"/>
                </StackPanel>
            </Border>

            <!-- Allerede registreret -->
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Allerede registreret på servicen" Style="{StaticResource SektionTitel}"/>
                    <DataGrid x:Name="dgRegistreret" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Dato" Binding="{Binding Dato, StringFormat=dd-MM-yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Reservedel" Binding="{Binding Reservedel.Navn}" Width="*"/>
                            <DataGridTextColumn Header="Antal" Binding="{Binding AntalTaget}" Width="70"/>
                            <DataGridTextColumn Header="Medarbejder" Binding="{Binding Medarbejder.Initialer}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Vælg reservedele -->
        <Border Style="{StaticResource Panel}" Margin="0,24,0,0">
            <StackPanel>
                <TextBlock Text="Vælg reservedele" Style="{StaticResource SektionTitel}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Reservedel" Style="{StaticResource FeltTitel}"/>
                        <ComboBox x:Name="cmbReservedel" ItemTemplate="{StaticResource ReservedelVisning}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Antal" Style="{StaticResource FeltTitel}"/>
                        <TextBox x:Name="txtAntal" Text="1"/>
                    </StackPanel>

                    <Button Grid.Column="4" Content="Tilføj" Click="Tilføj_Click" VerticalAlignment="Bottom" Margin="0,0,0,16"/>
                </Grid>

                <TextBlock Text="Reservedele på listen" Style="{StaticResource FeltTitel}"/>
                <DataGrid x:Name="dgListe" MaxHeight="240">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Reservedel" Binding="{Binding Reservedel.Navn}" Width="*"/>
                        <DataGridTextColumn Header="Leverandør" Binding="{Binding Reservedel.Leverandør.Navn}" Width="*"/>
                        <DataGridTextColumn Header="På lager" Binding="{Binding Reservedel.AntalPåLager}" Width="90"/>
                        <DataGridTextColumn Header="Antal" Binding="{Binding AntalTaget}" Width="80"/>
                        <DataGridTemplateColumn Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Fjern" Style="{StaticResource LilleKnap}" Click="Fjern_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Content="Gem / Opdater lager" Click="Gem_Click" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
