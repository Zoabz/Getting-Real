<UserControl x:Class="Vektor.Views.OpretReservedelSide"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Vektor.Views">
    <StackPanel>
        <TextBlock Text="Opret reservedel" Style="{StaticResource SideTitel}"/>
        <views:Besked x:Name="besked"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Ny reservedel -->
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Ny reservedel" Style="{StaticResource SektionTitel}"/>

                    <TextBlock Text="Navn" Style="{StaticResource FeltTitel}"/>
                    <TextBox x:Name="txtNavn"/>

                    <TextBlock Text="Leverandør" Style="{StaticResource FeltTitel}"/>
                    <TextBox x:Name="txtLeverandør"/>

                    <TextBlock Text="Minimum antal" Style="{StaticResource FeltTitel}"/>
                    <TextBox x:Name="txtMinimum"/>

                    <Button Content="Opret" Click="Opret_Click" IsDefault="True"/>
                </StackPanel>
            </Border>

            <!-- Liste -->
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Reservedele" Style="{StaticResource SektionTitel}"/>
                    <DataGrid x:Name="dgReservedele">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Navn" Binding="{Binding Navn}" Width="*"/>
                            <DataGridTextColumn Header="Leverandør" Binding="{Binding Leverandør.Navn}" Width="*"/>
                            <DataGridTextColumn Header="På lager" Binding="{Binding AntalPåLager}" Width="90"/>
                            <DataGridTextColumn Header="Minimum" Binding="{Binding MinimumAntal}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
