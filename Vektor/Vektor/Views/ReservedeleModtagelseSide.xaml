<UserControl x:Class="Vektor.Views.ReservedeleModtagelseSide"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Vektor.Views">
    <StackPanel>
        <TextBlock Text="Reservedele modtagelse" Style="{StaticResource SideTitel}"/>
        <views:Besked x:Name="besked"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Ny modtagelse -->
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Ny modtagelse" Style="{StaticResource SektionTitel}"/>

                    <TextBlock Text="Vælg reservedel (kun dem, der skal bestilles)" Style="{StaticResource FeltTitel}"/>
                    <ComboBox x:Name="cmbReservedel" ItemTemplate="{StaticResource ReservedelVisning}"
                              SelectionChanged="Reservedel_SelectionChanged"/>

                    <UniformGrid Columns="4" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="Leverandør" Style="{StaticResource FeltTitel}"/>
                            <TextBlock x:Name="txtLeverandør" Text="–" Style="{StaticResource FeltVærdi}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="På lager" Style="{StaticResource FeltTitel}"/>
                            <TextBlock x:Name="txtPåLager" Text="–" Style="{StaticResource FeltVærdi}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Minimum" Style="{StaticResource FeltTitel}"/>
                            <TextBlock x:Name="txtMinimum" Text="–" Style="{StaticResource FeltVærdi}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Mangler" Style="{StaticResource FeltTitel}"/>
                            <TextBlock x:Name="txtMangler" Text="–" Style="{StaticResource FeltVærdi}"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="Antal modtaget" Style="{StaticResource FeltTitel}"/>
                    <TextBox x:Name="txtAntal"/>

                    <TextBlock Text="Dato" Style="{StaticResource FeltTitel}"/>
                    <DatePicker x:Name="dpDato"/>

                    <Button Content="Modtag" Click="Modtag_Click"/>
                </StackPanel>
            </Border>

            <!-- Seneste modtagelser -->
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Seneste modtagelser" Style="{StaticResource SektionTitel}"/>
                    <DataGrid x:Name="dgModtagelser">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Dato" Binding="{Binding Dato, StringFormat=dd.MM.yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Reservedel" Binding="{Binding Reservedel.Navn}" Width="*" ElementStyle="{StaticResource Ombryd}"/>
                            <DataGridTextColumn Header="Leverandør" Binding="{Binding Reservedel.Leverandør.Navn}" Width="*" ElementStyle="{StaticResource Ombryd}"/>
                            <DataGridTextColumn Header="Antal" Binding="{Binding AntalModtaget}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
