<UserControl x:Class="Vektor.Views.UdførtArbejdeSide"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Vektor.Views">
    <StackPanel>
        <TextBlock Text="Udført arbejde" Style="{StaticResource SideTitel}"/>
        <views:Besked x:Name="besked"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Registrér arbejdet -->
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Registrér arbejdet" Style="{StaticResource SektionTitel}"/>

                    <TextBlock Text="Vælg service" Style="{StaticResource FeltTitel}"/>
                    <ComboBox x:Name="cmbService" ItemTemplate="{StaticResource ServiceVisning}"
                              SelectionChanged="Service_SelectionChanged"/>

                    <TextBlock Text="Vælg medarbejder" Style="{StaticResource FeltTitel}"/>
                    <ComboBox x:Name="cmbMedarbejder"/>

                    <TextBlock Text="Beskrivelse af udført arbejde" Style="{StaticResource FeltTitel}"/>
                    <TextBox x:Name="txtBeskrivelse" Style="{StaticResource StortTekstfelt}"/>

                    <Button Content="Gem og luk service" Click="Gem_Click"/>
                </StackPanel>
            </Border>

            <!-- Servicedetaljer -->
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Servicedetaljer" Style="{StaticResource SektionTitel}"/>

                    <TextBlock Text="Kunde" Style="{StaticResource FeltTitel}"/>
                    <TextBlock x:Name="txtKunde" Text="–" Style="{StaticResource FeltVærdi}"/>

                    <TextBlock Text="Mærke og model" Style="{StaticResource FeltTitel}"/>
                    <TextBlock x:Name="txtCykel" Text="–" Style="{StaticResource FeltVærdi}"/>

                    <TextBlock Text="Fejltype" Style="{StaticResource FeltTitel}"/>
                    <TextBlock x:Name="txtFejltype" Text="–" Style="{StaticResource FeltVærdi}"/>

                    <TextBlock Text="Fejlbeskrivelse" Style="{StaticResource FeltTitel}"/>
                    <TextBlock x:Name="txtFejlbeskrivelse" Text="–" Style="{StaticResource FeltVærdi}"/>

                    <TextBlock Text="Reservedele" Style="{StaticResource FeltTitel}"/>
                    <TextBlock x:Name="txtReservedele" Text="–" Style="{StaticResource FeltVærdi}" Margin="0"/>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
