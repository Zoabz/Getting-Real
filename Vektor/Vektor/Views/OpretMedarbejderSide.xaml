<UserControl x:Class="Vektor.Views.OpretMedarbejderSide"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Vektor.Views">
    <StackPanel>
        <TextBlock Text="Opret medarbejder" Style="{StaticResource SideTitel}"/>
        <views:Besked x:Name="besked"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Ny medarbejder -->
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Ny medarbejder" Style="{StaticResource SektionTitel}"/>

                    <TextBlock Text="Navn" Style="{StaticResource FeltTitel}"/>
                    <TextBox x:Name="txtNavn"/>

                    <TextBlock Text="Initialer" Style="{StaticResource FeltTitel}"/>
                    <TextBox x:Name="txtInitialer" CharacterCasing="Upper" MaxLength="5"/>

                    <Button Content="Opret" Click="Opret_Click" IsDefault="True"/>
                </StackPanel>
            </Border>

            <!-- Liste -->
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Medarbejdere" Style="{StaticResource SektionTitel}"/>
                    <DataGrid x:Name="dgMedarbejdere">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nr." Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Navn" Binding="{Binding Navn}" Width="*"/>
                            <DataGridTextColumn Header="Initialer" Binding="{Binding Initialer}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
