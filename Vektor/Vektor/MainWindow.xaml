<Window x:Class="Vektor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vektor"
        Width="1280" Height="820" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="White" FontFamily="Segoe UI" FontSize="14">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu -->
        <Border Background="{StaticResource Sort}">
            <StackPanel Margin="0,28,0,0">
                <TextBlock Text="Vektor" Foreground="White" FontSize="30" FontWeight="Bold" Margin="34,0,0,8"/>

                <TextBlock Text="KUNDER &amp; MEDARBEJDERE" Style="{StaticResource MenuGruppe}"/>
                <RadioButton x:Name="MenuOpretMedarbejder" Content="Opret medarbejder" Style="{StaticResource MenuPunkt}" Click="Menu_Click"/>
                <RadioButton x:Name="MenuOpretKunde" Content="Opret kunde" Style="{StaticResource MenuPunkt}" Click="Menu_Click"/>

                <TextBlock Text="SERVICE" Style="{StaticResource MenuGruppe}"/>
                <RadioButton x:Name="MenuOpretService" Content="Opret service" Style="{StaticResource MenuPunkt}" Click="Menu_Click"/>
                <RadioButton x:Name="MenuServiceKvittering" Content="Service kvittering" Style="{StaticResource MenuPunkt}" Click="Menu_Click"/>
                <RadioButton x:Name="MenuReservedeleUdtag" Content="Reservedele udtag" Style="{StaticResource MenuPunkt}" Click="Menu_Click"/>
                <RadioButton x:Name="MenuUdførtArbejde" Content="Udført arbejde" Style="{StaticResource MenuPunkt}" Click="Menu_Click"/>

                <TextBlock Text="LAGER" Style="{StaticResource MenuGruppe}"/>
                <RadioButton x:Name="MenuLagerOgBestilling" Content="Lager og bestilling" Style="{StaticResource MenuPunkt}" Click="Menu_Click"/>
                <RadioButton x:Name="MenuOpretReservedel" Content="Opret reservedel" Style="{StaticResource MenuPunkt}" Click="Menu_Click"/>
                <RadioButton x:Name="MenuReservedeleModtagelse" Content="Reservedele modtagelse" Style="{StaticResource MenuPunkt}" Click="Menu_Click"/>
            </StackPanel>
        </Border>

        <!-- Den valgte side -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ContentControl x:Name="Indhold" Margin="40,32,40,40"/>
        </ScrollViewer>
    </Grid>
</Window>
