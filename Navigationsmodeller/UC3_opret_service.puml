while (Mangler kunde, mærke, model, fejltype eller\nbeskrivelse?) is (Ja)
  :Vis fx »Skriv bilens mærke, fx Hyundai.« øverst
på siden;
  :Udfyld det, der mangler;
  :Vælg »Opret« igen;
endwhile (Nej)
