@startuml
skinparam monochrome true
skinparam shadowing false
skinparam nodesep 60
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor white
  BorderColor black
}
hide circle
hide methods

class Kunde {
  navn
  telefonnummer
}

class Reparation {
  reparationsnummer
  indleveringsdato
  cykelbeskrivelse
  fejlbeskrivelse
  aftaltAfhentningsdato
  status
}

class Udtag {
  dato
  antalTaget
}

class Medarbejder {
  navn
  initialer
}

class Reservedel {
  varenummer
  beskrivelse
  enhed
  beholdning
  minimumsbeholdning
}

class Leverandør {
  navn
  adresse
}

class Bestilling {
  købsordrenummer
  dato
  ønsketLeveringsdato
  bemærkning
  status
}

class Bestillingslinje {
  bestillingsantal
  forfaldsdato
  modtagetAntal
}

Kunde "1" -right-- "1..*" Reparation
Reparation "1" -down- "*" Udtag
Udtag "*" -right-- "1" Reservedel
Udtag "*" -down- "1" Medarbejder
Reservedel "1..*" -down- "1" Leverandør
Reservedel "1" -down- "*" Bestillingslinje
Leverandør "1" -down- "*" Bestilling
Medarbejder "1" -right- "*" Bestilling
Bestilling "1" -right-- "*" Bestillingslinje
@enduml
