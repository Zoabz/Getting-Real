@startuml domænemodel_ny
' Domænemodel – Vekto Cykelværksted (UC1–UC9)

skinparam backgroundColor #FFFFFF
skinparam linetype ortho
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam nodesep 70
skinparam ranksep 70
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  ArrowColor #000000
}
hide circle
hide methods
hide empty members

class Kunde {
  navn
  telefonnummer
}

class Cykel {
  mærke
  model
}

class Reparation {
  reparationsnummer
  fejltype
  fejlbeskrivelse
  status
}

class "Udført arbejde" as UdfoertArbejde {
  beskrivelse
}

class Medarbejder {
  navn
  initialer
}

class Udtag {
  antalTaget
}

class Reservedel {
  navn
  antalPåLager
  minimumsantal
}

class Leverandør {
  navn
}

class Modtagelse {
  dato
  antalModtaget
}

Kunde "1" -down- "0..*" Cykel
Cykel "1" -down- "1..*" Reparation
Reparation "1" -down- "0..1  " UdfoertArbejde
UdfoertArbejde "0..*" -down- "1" Medarbejder
Reparation "1  " -down- "0..*" Udtag
Medarbejder "1" -right- "0..*" Udtag
Udtag "0..*" -right- "1" Reservedel
Leverandør "1" -down- "1..*" Reservedel
Reservedel "1" -down- "0..*" Modtagelse

@enduml