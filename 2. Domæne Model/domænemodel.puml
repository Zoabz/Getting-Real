@startuml
' Samme model som domænemodel.png / domænemodel.drawio
skinparam monochrome true
skinparam shadowing false
skinparam nodesep 80
skinparam ranksep 60
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor white
  BorderColor black
}
hide circle
hide methods

class Kunde {
  navn
  telefonnummer
}

class Service {
  servicenummer
  indleveringsdato
  mærke
  model
  fejltype
  fejlbeskrivelse
  udførtArbejde
  status
}

class Medarbejder {
  navn
  initialer
}

class Udtag {
  dato
  antalTaget
}

class Reservedel {
  navn
  antalPåLager
  minimumAntal
}

class Leverandør {
  navn
}

class Modtagelse {
  dato
  antalModtaget
}

class "Service Oversigt" {
  medarbejder
  servicenummer
  beskrivelse
}

Kunde "1" -right- "0..*" Service
Service "0..*" -right- "0..1" Medarbejder
Service "1" -down- "0..*" Udtag
Udtag "0..*" -right- "1" Medarbejder
Udtag "0..*" -down- "1" Reservedel
Leverandør "1" -right- "1..*" Reservedel
Reservedel "1" -right- "0..*" Modtagelse
Medarbejder "1" -right- "1" "Service Oversigt"
"Service Oversigt" "1" -up- "1" Service
@enduml