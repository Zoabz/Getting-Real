<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- Datafilerne kopieres til mappen med programmets exe-fil (bin\Debug\net10.0-windows) -->
  <ItemGroup>
    <None Update="Customer.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Employee.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
