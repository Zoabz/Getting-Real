@startuml
' Samme objekter som objektmodel.png / objektmodel.drawio.
' PlantUML kan ikke tegne de buede linjer, så layoutet er ikke helt det samme.
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}

rectangle "Kunde" as hK
rectangle "Reparation" as hR
rectangle "Medarbejder" as hM
rectangle "Udtag" as hU
rectangle "Reservedel" as hS
rectangle "Leverandør" as hL
rectangle "Modtagelse" as hMo

usecase "Frederik Eriksen\n+4523129428" as frederik
usecase "1001\n03-11-2026\nTrek\nFX 2\nBremser\nBremser hviner\nSkiftet klodser\nLukket" as r1001
usecase "1002\n04-11-2026\nKildemoes\nCity\nBremser\nSlap bremse\n-\nÅben" as r1002
usecase "John Pedersen\nJP" as john
usecase "Lise Madsen\nLM" as lise
usecase "03-11-2026\n2" as u1
usecase "04-11-2026\n1" as u2
usecase "Bremseklodser\n4\n4" as klodser
usecase "Bremsekabel\n9\n3" as kabel
usecase "Nordic Bike\nParts A/S" as nordic
usecase "02-11-2026\n7" as mod1

hK -[hidden]right- hR
hR -[hidden]right- hM
hM -[hidden]right- hU
hU -[hidden]right- hS
hS -[hidden]right- hL
hL -[hidden]right- hMo

hK -[hidden]down- frederik
hR -[hidden]down- r1001
hM -[hidden]down- john
hU -[hidden]down- u1
hS -[hidden]down- klodser
hL -[hidden]down- nordic
hMo -[hidden]down- mod1

frederik -- r1001
frederik -- r1002
r1001 -right- john
john -right- u1
r1001 -- u1
lise -right- u2
r1002 -- u2
u1 -right- klodser
u2 -right- kabel
klodser -- nordic
kabel -- nordic
kabel -- mod1
@enduml
