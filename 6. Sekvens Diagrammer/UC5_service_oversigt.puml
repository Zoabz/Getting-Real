@startuml
hide footbox
title <U>SD UC5 - Service Overview of Repairs</U>

participant ":CompletedWorkView" as View #White
participant ":ServiceController" as Controller #White
participant ":ServiceRepository" as Repository #White

[-> View : openCompletedWorkView()
activate View

View -> Controller : saveCompletedWork(serviceId, employeeId,\ndescription)
activate Controller

alt description missing
    Controller --> View : showError("Description is required")

else else
    Controller -> Repository : findById(serviceId)
    activate Repository
    Repository --> Controller : service
    deactivate Repository

    alt service not found or closed
        Controller --> View : showError("Service unavailable")

    else service found
        Controller -> Repository : saveCompletedWork(serviceId,\nemployeeId, description)
        activate Repository
        Repository --> Controller : success
        deactivate Repository

        Controller -> Repository : updateStatus(serviceId, "Closed")
        activate Repository
        Repository --> Controller : success
        deactivate Repository

        Controller --> View : showConfirmation("Work saved")
    end
end

deactivate Controller
deactivate View

@enduml