@startuml
' SD i samme stil som undervisningens SD for RegisterGuest (Pr20)
skinparam style strictuml
skinparam ParticipantBackgroundColor white
skinparam ParticipantBorderColor black
skinparam ArrowColor black
skinparam SequenceLifeLineBorderColor black
skinparam SequenceGroupBackgroundColor white
skinparam SequenceGroupBorderColor black
skinparam SequenceDividerBackgroundColor white
skinparam SequenceDividerBorderColor black
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam ActivationBackgroundColor white
skinparam shadowing false
skinparam sequenceParticipant underline
skinparam defaultFontName Arial
hide footbox
title SD UC3 - Create Service

participant ":CreateServiceController" as C
participant ":CustomerRepo" as KR
participant ":ServiceRepo" as SR

== SearchCustomer ==
[-> C : SearchCustomer(phoneNumber)
activate C
C -> KR : customer = GetById(phoneNumber)
activate KR
deactivate KR

alt customer == null
    [<-- C : error "Create customer first"
else customer != null
    [<-- C : customer
end
deactivate C

== CreateService ==
[-> C : CreateService(phoneNumber, brand, model,\nerrorType, description)
activate C

alt information missing
    [<-- C : error "Missing information"

else all information filled in
    C -> KR : customer = GetById(phoneNumber)
    activate KR
    deactivate KR

    C -> SR : serviceId = GetNextId()
    activate SR
    deactivate SR

    create participant ":Service" as S
    C -->> S : service = «create»(serviceId, customer,\nbrand, model, errorType, description)
    note right of S
      DropOffDate = today
      Status = Open
    end note

    C -> SR : Add(service)
    activate SR
    deactivate SR

    [<-- C : service
end
deactivate C

@enduml
