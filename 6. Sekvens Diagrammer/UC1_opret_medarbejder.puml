@startuml
hide footbox
title <U>SD UC1 - Create Employee

participant ":EmployeeView" as View #White
participant ":EmployeeController" as Controller #White
participant ":EmployeeRepository" as Repository #White



[-> View : openEmployeeView()
activate View

View -> Controller : createEmployee(name, initials)
activate Controller

alt name missing
    Controller --> View : showError("Name is required")

else initials missing
    Controller --> View : showError("Initials are required")

else valid information
    Controller -> Repository : generateUniqueEmployeeId()
    activate Repository
    Repository --> Controller : employeeId
    deactivate Repository

    Controller -> Repository : addEmployee(employeeId, name, initials)
    activate Repository
    Repository --> Controller : success
    deactivate Repository

    Controller --> View : showConfirmation(employeeId)
end

deactivate Controller
deactivate View

@enduml