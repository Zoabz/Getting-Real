@startuml
' SD i samme stil som undervisningens SD for RegisterGuest (Pr20)
skinparam style strictuml
skinparam ParticipantBackgroundColor white
skinparam ParticipantBorderColor black
skinparam ArrowColor black
skinparam SequenceLifeLineBorderColor black
skinparam SequenceGroupBackgroundColor white
skinparam SequenceGroupBorderColor black
skinparam SequenceDividerBackgroundColor white
skinparam SequenceDividerBorderColor black
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam ActivationBackgroundColor white
skinparam shadowing false
skinparam sequenceParticipant underline
skinparam defaultFontName Arial
hide footbox
title SD UC1 - Create Employee

participant ":CreateEmployeeController" as C
participant ":EmployeeRepo" as R

== CreateEmployee ==
[-> C : CreateEmployee(name, initials)
activate C

alt name or initials missing
    [<-- C : error "Name and initials are required"

else name and initials filled in
    C -> R : employee = GetById(initials)
    activate R
    deactivate R

    alt employee != null
        [<-- C : error "Initials already in use"

    else employee == null
        create participant ":Employee" as E
        C -->> E : employee = «create»(name, initials)

        C -> R : Add(employee)
        activate R
        deactivate R

        [<-- C : employee
    end
end
deactivate C

== GetAllEmployees ==
[-> C : GetAllEmployees()
activate C
C -> R : employees = GetAll()
activate R
deactivate R
[<-- C : employees
deactivate C

@enduml
