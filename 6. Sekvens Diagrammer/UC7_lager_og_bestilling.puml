@startuml
hide footbox
title <U>SD UC7 - Inventory And Ordering Of Spare Parts</U>

participant ":InventoryView" as View #White
participant ":InventoryController" as Controller #White
participant ":InventoryRepository" as Repository #White

[-> View : openInventoryView()
activate View

View -> Controller : getInventoryOverview()
activate Controller

Controller -> Repository : getAllParts()
activate Repository
Repository --> Controller : parts
deactivate Repository

alt no spare parts found
    Controller --> View : showMessage("No spare parts found")

else else
    Controller --> View : showInventoryTable(parts)

    Controller -> Repository : getPartsBelowMinimum()
    activate Repository
    Repository --> Controller : partsToOrder
    deactivate Repository

    alt no parts need ordering
        Controller --> View : showMessage("Nothing to order")

    else else
        Controller --> View : showSortedOrderList(partsToOrder)
    end
end

deactivate Controller
deactivate View

@enduml