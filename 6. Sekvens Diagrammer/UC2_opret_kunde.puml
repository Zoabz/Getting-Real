@startuml
' SD i samme stil som undervisningens SD for RegisterGuest (Pr20)
skinparam style strictuml
skinparam ParticipantBackgroundColor white
skinparam ParticipantBorderColor black
skinparam ArrowColor black
skinparam SequenceLifeLineBorderColor black
skinparam SequenceGroupBackgroundColor white
skinparam SequenceGroupBorderColor black
skinparam SequenceDividerBackgroundColor white
skinparam SequenceDividerBorderColor black
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam ActivationBackgroundColor white
skinparam shadowing false
skinparam sequenceParticipant underline
skinparam defaultFontName Arial
hide footbox
title SD UC2 - Create Customer In Store

participant ":CreateCustomerController" as C
participant ":CustomerRepo" as R

== CreateCustomer ==
[-> C : CreateCustomer(name, phoneNumber)
activate C

alt name missing or phone number invalid
    [<-- C : error "Name and a valid phone number are required"

else valid information
    C -> R : customer = GetById(phoneNumber)
    activate R
    deactivate R

    alt customer != null
        [<-- C : error "Customer already exists"

    else customer == null
        create participant ":Customer" as K
        C -->> K : customer = «create»(name, phoneNumber)

        C -> R : Add(customer)
        activate R
        deactivate R

        [<-- C : customer
    end
end
deactivate C

== GetAllCustomers ==
[-> C : GetAllCustomers()
activate C
C -> R : customers = GetAll()
activate R
deactivate R
[<-- C : customers
deactivate C

@enduml
