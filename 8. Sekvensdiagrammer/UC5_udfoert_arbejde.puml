@startuml
title SD: UC5 Udført Arbejde
hide footbox
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam dpi 150
skinparam defaultFontName Arial
skinparam participant {
  BackgroundColor white
}
skinparam note {
  BackgroundColor white
}

participant ":Værksted" as v
participant "r : Reparation" as r

== Vælg service ==
ref over v : SøgServices("", ReparationStatus.Åben) – se UC4
[-> r : HentUdtag()
activate r
[<-- r : udtag : List<Udtag>
deactivate r
note right of r
  UI-laget viser r.Kunde, r.Mærke - r.Model,
  r.Fejltype, r.Fejlbeskrivelse og antal udtag
end note

== Registrér udført arbejde ==
[-> v : RegistrerUdførtArbejde(r, m, beskrivelse)
activate v
note right of v
  m er valgt i "Vælg medarbejder",
  beskrivelse indlæses fra UI-laget
end note

alt r eller m mangler, beskrivelse er tom, eller r.Status == Lukket
  [<-- v : throw ArgumentException(fejlbesked)
else alt er udfyldt
  v -> r : Luk(m, beskrivelse)
  activate r
  note right of r
    UdførtArbejde = beskrivelse
    UdførtAf = m
    LukketDato = DateTime.Now
    Status = ReparationStatus.Lukket
  end note
  r --> v
  deactivate r
  v -> v : Gem()
  activate v
  participant "datafil : Datafil" as datafil
  v -> datafil : Gem(this)
  activate datafil
  datafil --> v
  deactivate datafil
  deactivate v
  [<-- v
end
deactivate v
@enduml
