@startuml
title SD: UC2 Opret Kunde
hide footbox
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam dpi 150
skinparam defaultFontName Arial
skinparam participant {
  BackgroundColor white
}
skinparam note {
  BackgroundColor white
}

participant ":Værksted" as v
participant "kunder : List<Kunde>" as liste

[-> v : OpretKunde(navn, telefonnummer)
activate v
note right of v
  navn og telefonnummer indlæses
  fra UI-laget (Opret kunde)
  telefonnummer = telefonnummer.Replace(" ", "")
end note
v -> liste : Any(k => k.Telefonnummer == telefonnummer)
activate liste
liste --> v : findes
deactivate liste

alt navn mangler, telefonnummeret er ugyldigt, eller findes == true
  [<-- v : throw ArgumentException(fejlbesked)
else oplysningerne er gyldige
  note right of v
    id = kunder.Count + 1
  end note
  create participant "k : Kunde" as k
  v -> k : create(id, navn, telefonnummer)
  v -> liste : Add(k)
  activate liste
  deactivate liste
  v -> v : Gem()
  activate v
  participant "datafil : Datafil" as datafil
  v -> datafil : Gem(this)
  activate datafil
  datafil --> v
  deactivate datafil
  deactivate v
  [<-- v : k
end
deactivate v
@enduml
