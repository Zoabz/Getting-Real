@startuml
title SD: UC9 Opret Reservedele Modtagelse
hide footbox
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam dpi 150
skinparam defaultFontName Arial
skinparam participant {
  BackgroundColor white
}
skinparam note {
  BackgroundColor white
}

participant ":Værksted" as v
participant "rd : Reservedel" as rd

== Vælg reservedel ==
ref over v : HentBestillingsliste() – se UC7
[-> rd : Mangler()
activate rd
[<-- rd : mangler
deactivate rd
note right of rd
  UI-laget viser rd.Leverandør.Navn, rd.AntalPåLager,
  rd.MinimumAntal og mangler.
  "Antal modtaget" udfyldes med mangler.
end note

== Modtag ==
[-> v : RegistrerModtagelse(rd, antal, dato)
activate v
note right of v
  antal og dato indlæses fra UI-laget
end note
alt rd mangler, antal <= 0, eller dato > DateTime.Today
  [<-- v : throw ArgumentException(fejlbesked)
else oplysningerne er gyldige
  v -> rd : SkalBestilles()
  activate rd
  rd --> v : bool
  deactivate rd
  alt SkalBestilles == false
    [<-- v : throw InvalidOperationException(fejlbesked)
  else reservedelen står på bestillingslisten
    create participant "mo : Modtagelse" as mo
    v -> mo : create(rd, antal, dato)
    participant "modtagelser : List<Modtagelse>" as liste
    v -> liste : Add(mo)
    activate liste
    deactivate liste
    v -> rd : OpskrivLager(antal)
    activate rd
    note right of rd : AntalPåLager += antal
    deactivate rd
    v -> v : Gem()
    activate v
    participant "datafil : Datafil" as datafil
    v -> datafil : Gem(this)
    activate datafil
    datafil --> v
    deactivate datafil
    deactivate v
    [<-- v : mo
  end
end
deactivate v
@enduml
