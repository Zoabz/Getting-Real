@startuml
title SD: UC7 Lager og bestilling
hide footbox
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam dpi 150
skinparam defaultFontName Arial
skinparam participant {
  BackgroundColor white
}
skinparam note {
  BackgroundColor white
}

participant ":Værksted" as v
participant "rd : Reservedel" as rd

== Lageroversigt ==
[-> v : HentLageroversigt()
activate v
[<-- v : reservedele : List<Reservedel>
deactivate v
loop for hver rd i lageroversigten
  [-> rd : SkalBestilles()
  activate rd
  [<-- rd : bool
  deactivate rd
end
note right of rd
  UI-laget viser Navn, AntalPåLager, MinimumAntal
  og status: OK eller Skal bestilles
end note

== Bestillingsliste ==
[-> v : HentBestillingsliste()
activate v
loop for hver rd i reservedele
  v -> rd : SkalBestilles()
  activate rd
  note right of rd : AntalPåLager <= MinimumAntal
  rd --> v : bool
  deactivate rd
  opt SkalBestilles == true
    v -> rd : Mangler()
    activate rd
    note right of rd : MinimumAntal - AntalPåLager
    rd --> v : mangler
    deactivate rd
  end
end
note right of v
  listen sorteres efter mangler,
  så den største står øverst
end note
[<-- v : bestillingsliste : List<Reservedel>
deactivate v
@enduml
