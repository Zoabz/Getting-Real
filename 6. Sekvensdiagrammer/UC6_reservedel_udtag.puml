@startuml
hide footbox
title <U>SD UC6 - Spare Parts Withdrawal

participant ":WithdrawalView" as View
participant ":WithdrawalController" as Controller
participant ":InventoryRepository" as Repository

[-> View : openWithdrawalView()
activate View

loop for each spare part
    View -> Controller : addPart(partId, quantity)
    activate Controller

    alt quantity invalid
        Controller --> View : showError("Invalid quantity")

    else quantity valid 
        Controller --> View : addToWithdrawalList(partId, quantity)
    end

    deactivate Controller
end

View -> Controller : saveWithdrawal(serviceId, employeeId, parts)
activate Controller

Controller -> Repository : checkStock(parts)
activate Repository
Repository --> Controller : stockResult
deactivate Repository

alt insufficient stock
    Controller --> View : showError("Insufficient stock", stockResult)

else stock found 
    Controller -> Repository : saveWithdrawalAndUpdateStock(\nserviceId, employeeId, parts)
    activate Repository
    Repository --> Controller : success
    deactivate Repository

    Controller --> View : showConfirmation("Withdrawal saved")
end

deactivate Controller
deactivate View

@enduml