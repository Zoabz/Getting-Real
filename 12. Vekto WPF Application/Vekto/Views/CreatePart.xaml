<UserControl x:Class="Vekto.Views.CreatePart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= OPRET RESERVEDEL (UC8 - wireframe 09) ================= -->
    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Overskrift -->
        <StackPanel Grid.Row="0" Margin="20,20,20,0">
            <TextBlock Text="Opret reservedel" FontSize="22" FontWeight="Bold"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="20,10,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Ny reservedel ===== -->
            <StackPanel Grid.Column="0" Background="White" VerticalAlignment="Top">
                <Label Content="Ny reservedel" FontSize="15" FontWeight="Bold" Margin="10"/>

                <Grid Margin="10,0,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- (1) Navn: skal være unikt -->
                    <Label Grid.Row="0" Grid.Column="0" Content="Reservedel navn"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="tbName" Height="25" Margin="0,0,0,5"/>

                    <!-- (3) Leverandør -->
                    <Label Grid.Row="1" Grid.Column="0" Content="Leverandør"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="tbSupplier" Height="25" Margin="0,0,0,5"/>

                    <!-- (4) Minimum antal -->
                    <Label Grid.Row="2" Grid.Column="0" Content="Minimum antal"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="tbMinQuantity" Height="25" Margin="0,0,0,5"/>

                    <!-- (5) Opret -->
                    <Button Grid.Row="4" Grid.Column="1" x:Name="btnCreate" Content="Opret"
                            Width="80" Height="30" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Background="#FFEBEBEB" Foreground="Black" Click="btnCreate_Click"/>

                    <!-- Besked under knappen: fejl i rød, bekræftelse i grøn (teksten sættes i koden) -->
                    <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
                        <TextBlock x:Name="tbError" Foreground="Red" TextWrapping="Wrap"/>
                        <TextBlock x:Name="tbSuccess" Foreground="Green" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ===== (2) Reservedelsliste ===== -->
            <StackPanel Grid.Column="2" Background="White" VerticalAlignment="Top">
                <Label Content="Reservedele" FontSize="15" FontWeight="Bold" Margin="10"/>

                <DataGrid x:Name="dgParts" Height="250" Margin="10,0,10,10"
                          ItemsSource="{Binding Parts}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="White" BorderBrush="LightGray">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Navn" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Leverandør" Binding="{Binding Supplier}" Width="*"/>
                        <DataGridTextColumn Header="På lager" Binding="{Binding Quantity}" Width="70"/>
                        <DataGridTextColumn Header="Min." Binding="{Binding MinQuantity}" Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
