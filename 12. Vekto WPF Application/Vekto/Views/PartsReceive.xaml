<UserControl x:Class="Vekto.Views.PartsReceive"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= RESERVEDELE MODTAGELSE (UC9 - wireframe 10) ================= -->
    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Overskrift -->
        <StackPanel Grid.Row="0" Margin="20,20,20,0">
            <TextBlock Text="Reservedele modtagelse" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Registrér varer fra leverandøren. Kun reservedele på bestillingslisten kan vælges." Foreground="Gray"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="20,10,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Ny modtagelse ===== -->
            <StackPanel Grid.Column="0" Background="White" VerticalAlignment="Top">
                <Label Content="Ny modtagelse" FontSize="15" FontWeight="Bold" Margin="10"/>

                <Grid Margin="10,0,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- (1) Vælg reservedel -->
                    <Label Grid.Row="0" Grid.Column="0" Content="Vælg reservedel"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cbPart" Height="25" Margin="0,0,0,5"
                              ItemsSource="{Binding OrderList}" SelectedItem="{Binding SelectedPart}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Viser kun dele, der skal bestilles." Foreground="Gray"/>

                    <!-- (3) Reservedelens detaljer -->
                    <Grid Grid.Row="2" Grid.Column="1" Background="#FFF7F2EF" Margin="0,5,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Leverandør" Foreground="Gray"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="5" Text="{Binding SelectedPart.Supplier}"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="På lager" Foreground="Gray"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="5" Text="{Binding SelectedPart.Quantity}"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Minimum" Foreground="Gray"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="5" Text="{Binding SelectedPart.MinQuantity}"/>

                        <Label Grid.Row="3" Grid.Column="0" Content="Mangler" Foreground="Gray"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="5" Text="{Binding SelectedPart.Missing}"/>
                    </Grid>

                    <!-- (4) Antal modtaget -->
                    <Label Grid.Row="3" Grid.Column="0" Content="Antal modtaget"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="tbAmount" Height="25" Margin="0,0,0,5"
                             Text="{Binding Amount}"/>

                    <!-- (5) Dato -->
                    <Label Grid.Row="4" Grid.Column="0" Content="Dato"/>
                    <DatePicker Grid.Row="4" Grid.Column="1" x:Name="dpDate" Height="25" Margin="0,0,0,5"/>

                    <!-- (6) Modtag -->
                    <Button Grid.Row="5" Grid.Column="1" x:Name="btnReceive" Content="Modtag"
                            Width="80" Height="30" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Background="#FFEBEBEB" Foreground="Black" Click="btnReceive_Click"/>

                    <!-- Besked under knappen: fejl i rød, bekræftelse i grøn (teksten sættes i koden) -->
                    <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
                        <TextBlock x:Name="tbError" Foreground="Red" TextWrapping="Wrap"/>
                        <TextBlock x:Name="tbSuccess" Foreground="Green" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ===== (2) Seneste modtagelser ===== -->
            <StackPanel Grid.Column="2" Background="White" VerticalAlignment="Top">
                <Label Content="Seneste modtagelser" FontSize="15" FontWeight="Bold" Margin="10"/>

                <DataGrid x:Name="dgDeliveries" Height="250" Margin="10,0,10,10"
                          ItemsSource="{Binding Deliveries}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="White" BorderBrush="LightGray">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Dato" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="90"/>
                        <DataGridTextColumn Header="Reservedel" Binding="{Binding PartName}" Width="*"/>
                        <DataGridTextColumn Header="Leverandør" Binding="{Binding Supplier}" Width="*"/>
                        <DataGridTextColumn Header="Antal" Binding="{Binding Amount}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
