<UserControl x:Class="Vekto.Views.CreateService"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= OPRET SERVICE ================= -->
    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Overskrift -->
        <StackPanel Grid.Row="0" Margin="20,20,20,0">
            <TextBlock Text="Opret service" FontSize="22" FontWeight="Bold"/>
        </StackPanel>

        <!-- ===== Én samlet formular: kunde + produkt info ===== -->
        <Grid Grid.Row="2" Margin="20,10,20,20" Background="White" VerticalAlignment="Top">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Vælg kunde -->
                <Label Grid.Row="0" Grid.ColumnSpan="2" Content="Vælg kunde" FontSize="15" FontWeight="Bold" Margin="0,0,0,5"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Tlf. nr."/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="tbPhone" Height="25" Margin="0,0,0,5"
                          IsEditable="True" ItemsSource="{Binding PhoneNumbers}"
                          TextBoxBase.TextChanged="tbPhone_TextChanged"/>


                <Label Grid.Row="2" Grid.Column="0" Content="Kunde"/>
                <Label Grid.Row="2" Grid.Column="1" x:Name="lblCustomer" Content="Ingen kunde fundet" Margin="0,0,0,5"/>

                <!-- 2. Produkt info -->
                <Label Grid.Row="3" Grid.ColumnSpan="2" Content="Produkt info" FontSize="15" FontWeight="Bold" Margin="0,10,0,5"/>

                <Label Grid.Row="4" Grid.Column="0" Content="Mærke"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="tbBrand" Height="25" Margin="0,0,0,5"/>

                <Label Grid.Row="5" Grid.Column="0" Content="Model"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="tbModel" Height="25" Margin="0,0,0,5"/>

                <Label Grid.Row="6" Grid.Column="0" Content="Fejltype"/>
                <ComboBox Grid.Row="6" Grid.Column="1" x:Name="cbErrorType" Height="25" Margin="0,0,0,5"
                          ItemsSource="{Binding ErrorTypes}"/>

                <Label Grid.Row="7" Grid.Column="0" Content="Fejl beskrivelse"/>
                <TextBox Grid.Row="7" Grid.Column="1" x:Name="tbDescription" Height="60" Margin="0,0,0,5" TextWrapping="Wrap"/>

                <Button Grid.Row="8" Grid.Column="1" x:Name="btnCreate" Content="Opret"
                        Width="80" Height="30" HorizontalAlignment="Left" Margin="0,10,0,0"
                        Background="#FFEBEBEB" Foreground="Black" Click="btnCreate_Click"/>

                <!-- Besked under knappen: fejl i rød, bekræftelse i grøn (teksten sættes i koden) -->
                <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <TextBlock x:Name="tbError" Foreground="Red" TextWrapping="Wrap"/>
                    <TextBlock x:Name="tbSuccess" Foreground="Green" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
