@startuml
title <u>UC8 - Opret Reservedele På Lageret</u>
hide footbox
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam actor {
  BackgroundColor white
}
skinparam participant {
  BackgroundColor white
}

actor ":Mekaniker"
participant ":System" as System

":Mekaniker" -> System : opretReservedel(navn, leverandør, minimumAntal)

alt oplysninger mangler, eller navnet findes allerede
  System --> ":Mekaniker" : fejlbesked
else else
  System --> ":Mekaniker" : reservedelId, antal på lager = 0
end

@enduml
