@startuml
' Understregningen er en sprite i stedet for <u>, fordi <u> bliver stiplet i SVG.
' Bredden (255) er titlens bredde. Ændres titlen, skal bredden og antal F'er rettes med.
sprite $ul [255x1/16] {
FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
}
title
<b>UC8 - Opret Reservedele På Lageret</b>
<$ul>
end title
hide footbox
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam actor {
  BackgroundColor white
}
skinparam participant {
  BackgroundColor white
}

actor ":Mekaniker"
participant ":System" as System

":Mekaniker" -> System : opretReservedel(navn, leverandør, minimumAntal)

alt oplysninger mangler, eller navnet findes allerede
  System --> ":Mekaniker" : fejlbesked
else else
  System --> ":Mekaniker" : reservedelId, antal på lager = 0
end

@enduml
