@startuml
title <u>UC5 - Udført Arbejde På Reparationen</u>
hide footbox
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam actor {
  BackgroundColor white
}
skinparam participant {
  BackgroundColor white
}

actor ":Mekaniker"
participant ":System" as System

":Mekaniker" -> System : vaelgService(serviceId)

System --> ":Mekaniker" : kundenavn, kundeTlf, mærke - model, fejltype, beskrivelse,\nregistrerede reservedele

":Mekaniker" -> System : registrerUdfoertArbejde(serviceId, medarbejder, beskrivelse)

alt service, medarbejder eller beskrivelse mangler
  System --> ":Mekaniker" : fejlbesked
else service, medarbejder og beskrivelse mangler ikke
  System --> ":Mekaniker" : Status = "Lukket", lukketidspunkt
end

@enduml
