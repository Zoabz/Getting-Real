@startuml
' Understregningen er en sprite i stedet for <u>, fordi <u> bliver stiplet i SVG.
' Bredden (176) er titlens bredde. Ændres titlen, skal bredden og antal F'er rettes med.
sprite $ul [176x1/16] {
FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
}
title
<b>UC1 - Opret Medarbejder</b>
<$ul>
end title
hide footbox
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam actor {
  BackgroundColor white
}
skinparam participant {
  BackgroundColor white
}

actor ":Mekaniker"
participant ":System" as System

":Mekaniker" -> System : opretMedarbejder(navn, initialerne)

alt navn eller  initialerne er optaget
  System --> ":Mekaniker" : fejlbesked
else else
  System --> ":Mekaniker" : medarbejderId, medarbejderliste
end

@enduml
