@startuml
title <u>UC1 - Opret Medarbejder</u>
hide footbox
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam actor {
  BackgroundColor white
}
skinparam participant {
  BackgroundColor white
}

actor ":Mekaniker"
participant ":System" as System

":Mekaniker" -> System : opretMedarbejder(navn, navnKort)

alt navn eller navnKort mangler, eller initialerne er optaget
  System --> ":Mekaniker" : fejlbesked
else else
  System --> ":Mekaniker" : medarbejderId, medarbejderliste
end

@enduml