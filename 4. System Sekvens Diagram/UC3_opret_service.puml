@startuml
' Understregningen er en sprite i stedet for <u>, fordi <u> bliver stiplet i SVG.
' Bredden (139) er titlens bredde. Ændres titlen, skal bredden og antal F'er rettes med.
sprite $ul [139x1/16] {
FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
}
title
<b>UC3 - Opret Service</b>
<$ul>
end title
hide footbox
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam actor {
  BackgroundColor white
}
skinparam participant {
  BackgroundColor white
}

actor ":Mekaniker"
participant ":System" as System

":Mekaniker" -> System : soegKunde(tlfNr)

System --> ":Mekaniker" : kundenavn, tlfNr

":Mekaniker" -> System : opretService(tlfNr, mærke, model, fejltype, fejlbeskrivelse)

alt oplysninger mangler
  System --> ":Mekaniker" : fejlbesked
else alle oplysninger er udfyldt
  System --> ":Mekaniker" : serviceId, Status = "Åben"
end

@enduml
