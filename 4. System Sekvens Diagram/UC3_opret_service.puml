@startuml
title UC3 - Opret Service
hide footbox
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam actor {
  BackgroundColor white
}
skinparam participant {
  BackgroundColor white
}

actor ":Mekaniker" as Mekaniker
participant ":System" as System

Mekaniker -> System : soegKunde(tlfNr)
System --> Mekaniker : kundenavn, tlfNr
Mekaniker -> System : opretService(tlfNr, mærke, model, fejltype, fejlbeskrivelse)
alt oplysninger mangler
  System --> Mekaniker : fejlbesked
else alle oplysninger er udfyldt
  System --> Mekaniker : serviceId, Status = "Åben"
end
@enduml
