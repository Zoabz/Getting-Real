@startuml
' Understregningen er en sprite i stedet for <u>, fordi <u> bliver stiplet i SVG.
' Bredden (169) er titlens bredde. Ændres titlen, skal bredden og antal F'er rettes med.
sprite $ul [169x1/16] {
FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
}
title
<b>UC4 - Service Kvittering</b>
<$ul>
end title
hide footbox
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam actor {
  BackgroundColor white
}
skinparam participant {
  BackgroundColor white
}

actor ":Mekaniker"
participant ":System" as System

loop indtil servicen står i tabellen
  ":Mekaniker" -> System : søgServices(søgetekst)
  
  System --> ":Mekaniker" : serviceliste: serviceId, kundenavn, kundeTlf, mærke - model,\nfejltype, beskrivelse, udført, status
  
end
":Mekaniker" -> System : visKvittering(serviceId)

System --> ":Mekaniker" : serviceId, kundenavn, kundeTlf, mærke - model, fejltype,\nbeskrivelse, udført arbejde, reservedele, status

@enduml
