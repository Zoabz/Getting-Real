@startuml
title <u>UC9 - Opret Reservedele Modtagelse</u>
hide footbox
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam actor {
  BackgroundColor white
}
skinparam participant {
  BackgroundColor white
}

actor ":Mekaniker"
participant ":System" as System

":Mekaniker" -> System : vaelgReservedel(reservedel)

System --> ":Mekaniker" : leverandør, antal på lager, minimum, mangler

":Mekaniker" -> System : modtagReservedel(reservedel, antal, dato)

alt oplysninger mangler, eller datoen ligger i fremtiden
  System --> ":Mekaniker" : fejlbesked
else 
  System --> ":Mekaniker" : antal på lager, Status = "OK" eller "Skal bestilles"
end

@enduml
