@startuml
title UC7 - Lager og bestilling
hide footbox
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam actor {
  BackgroundColor white
}
skinparam participant {
  BackgroundColor white
}

actor Mekaniker
participant ":System" as System

Mekaniker -> System : visLager()
activate System
System --> Mekaniker : lageroversigt: navn, antal på lager, minimum, status,\nbestillingsliste: navn, leverandør, antal på lager, minimum, mangler
deactivate System
@enduml
