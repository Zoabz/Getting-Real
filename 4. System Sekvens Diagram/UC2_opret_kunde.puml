@startuml
title <u>UC2 - Opret Kunde I Butikken</u>
hide footbox
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam actor {
  BackgroundColor white
}
skinparam participant {
  BackgroundColor white
}

actor ":Mekaniker"
participant ":System" as System

":Mekaniker" -> System : opretKunde(navn, tlfNr)

alt navn mangler, eller tlfNr er ugyldigt eller allerede oprettet
  System --> ":Mekaniker" : fejlbesked
else else
  System --> ":Mekaniker" : kundeId, kundeliste
end

@enduml